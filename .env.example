# Copy to .env (git-ignored), or run `make env` to generate random local values.
# LiveKit API key/secret shared by the server, the agents, and the lk CLI.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Signaling URL as seen from the host (browser, lk CLI)
LIVEKIT_URL=ws://localhost:7880

# Optional: a key for an external speech/LLM provider enables the voice agent
# (`make up` then also builds and deploys it). No quotes around values.
# The default pipeline needs only OPENAI_API_KEY.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
# Optional voice agent settings, as provider/model per stage. Defaults:
# VOICE_STT=openai/gpt-4o-mini-transcribe   (or deepgram/nova-3)
# VOICE_LLM=openai/gpt-4.1-mini             (or anthropic/claude-haiku-4-5)
# VOICE_TTS=openai/gpt-4o-mini-tts          (or deepgram/aura-2-andromeda-en)
# VOICE_TTS_VOICE=ash                       (OpenAI voices only)
# VOICE_INSTRUCTIONS=...                    (system prompt)
# VOICE_GREETING=...                        (spoken when the user joins)
